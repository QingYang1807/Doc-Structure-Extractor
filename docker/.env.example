# ============================================================
# 必填：OpenAI 相关配置
# 使用标准 OpenAI API 时，BASE_URL 填 https://api.openai.com/v1
# 如果使用兼容 OpenAI 接口的第三方服务，填对应的 BASE_URL
# ============================================================
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# 注意：项目代码中使用的模型名为 gpt-5.2（Replit AI 集成专属）
# 如果使用标准 OpenAI API，请将 artifacts/api-server/src/routes/extract.ts
# 中所有 "gpt-5.2" 替换为 "gpt-4o" 或其他您有权限访问的模型名

# ============================================================
# 数据库配置
# ============================================================
POSTGRES_USER=docapp
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=docextractor
